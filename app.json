{
  "expo": {
    "name": "PIC Verifica",
    "slug": "pic-verifica",
    "version": "0.1.0",
    "scheme": "picverifica",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0c2733",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sua localização é usada só para centralizar o mapa e ordenar os postos por distância. Ela não é guardada nem ligada a uma conta."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c2733",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c2733",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sua localização é usada só para centralizar o mapa e ordenar os postos por distância. Ela não é guardada nem ligada a uma conta."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
