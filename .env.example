# Origem da API pública da plataforma (base na RAIZ do host; as rotas levam /v1).
# O app não tem lógica de negócio própria: tudo o que ele mostra vem daqui.
EXPO_PUBLIC_PIC_API_URL=https://pic-api-production.up.railway.app

# Endereço do portal público. É o que vai nos links compartilhados, para que
# quem não tem o app instalado abra a mesma ficha no navegador.
EXPO_PUBLIC_PIC_SITE_URL=https://pic-web-production.up.railway.app
